BOT_TOKEN=сюда_токен_от_BotFather
# Твой Telegram user id (узнать командой /myid) — ему доступна команда /admin
ADMIN_ID=
# Ключ Google Books API (console.cloud.google.com → Credentials) — без него поиск часто отвечает 429
GOOGLE_BOOKS_KEY=
# Разрешённые чаты через запятую (ID узнать командой /chatid). Пусто — бот работает в любом чате.
ALLOWED_CHAT_IDS=
# Стартовый набор жанров для каждого нового чата; дальше жанры добавляются кнопкой «➕ Новый жанр»
GENRES=Роман,Драма,Нон-фикшн,Поэзия,Фантастика,Детектив,Другое
